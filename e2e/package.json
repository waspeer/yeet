{
  "name": "yeet-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end verification harness for yeet: CLI, Worker and download page in real browsers",
  "type": "module",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --grep-invert @slow",
    "install-browsers": "playwright install chromium webkit firefox",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
