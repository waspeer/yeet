{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yeet",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Sentry needs AsyncLocalStorage; it also exposes vars/secrets on process.env.
  "compatibility_flags": ["nodejs_compat"],
  // Bundles the download page's shader background into public/client.js.
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "./public" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "yeet" }],
  // Counters for failed logins, download passwords and bearer tokens (one
  // object per client key). SQLite-backed, the only kind the free plan offers.
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Hourly cleanup of expired and abandoned uploads: each run does a small,
  // bounded slice of the bucket (see src/cleanup.ts).
  "triggers": { "crons": ["0 * * * *"] },
  // Share links live on <name>.<account>.workers.dev unless a custom domain is
  // added; per-version preview URLs would serve every version on its own host.
  "workers_dev": true,
  "preview_urls": false,
  // No "vars": UPLOADS_PREFIX and DOWNLOAD_URL_TTL have defaults in the code
  // and can be set in the dashboard. Vars listed here would overwrite the
  // dashboard values on every deploy.
  "observability": { "enabled": true },
}
