{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yeet",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Sentry needs AsyncLocalStorage; it also exposes vars/secrets on process.env.
  "compatibility_flags": ["nodejs_compat"],
  // Bundles the download page's shader background into public/client.js.
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "./public" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "yeet" }],
  // Daily cleanup of expired and abandoned uploads.
  "triggers": { "crons": ["0 3 * * *"] },
  // Erik's links live on <name>.<account>.workers.dev; per-version preview
  // URLs would expose every deployed version under its own hostname.
  "workers_dev": true,
  "preview_urls": false,
  // No "vars": UPLOADS_PREFIX and DOWNLOAD_URL_TTL have defaults in the code
  // and can be set in the dashboard. Vars listed here would overwrite the
  // dashboard values on every deploy.
  "observability": { "enabled": true },
}
