{
  "name": "@waspeer/yeet",
  "version": "0.3.0",
  "description": "Share files from your terminal with expiring, optionally password-protected download links, served by your own Cloudflare Worker",
  "keywords": [
    "cli",
    "cloudflare",
    "file-sharing",
    "r2",
    "upload",
    "workers"
  ],
  "homepage": "https://github.com/waspeer/yeet#readme",
  "bugs": "https://github.com/waspeer/yeet/issues",
  "license": "MIT",
  "author": "Wannes Salomé",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waspeer/yeet.git",
    "directory": "packages/cli"
  },
  "bin": {
    "yeet": "./dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
