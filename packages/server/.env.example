# S3-compatible storage (Cloudflare R2 recommended). Required.
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yeet

# Optional
# R2_UPLOADS_PREFIX=uploads           # key prefix inside the bucket
# R2_PRESIGN_EXPIRY_SECONDS=3600      # lifetime of generated download URLs
# R2_REGION=auto                      # signing region; set it for non-R2 providers
# PORT=3000
# SENTRY_DSN=                         # enables error reporting + session replay on errors
